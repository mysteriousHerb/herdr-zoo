{
  "id": "root",
  "colors": {
    "selection": "#4f7cff59",
    "done": "#8a8f98"
  },
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "stack",
              "size": {
                "weight": 2
              },
              "min": 90,
              "active": "agents-zoo",
              "children": [
                {
                  "id": "agents-list",
                  "type": "block",
                  "content": {
                    "mod": "zoo-agents",
                    "props": {
                      "stack": "agents",
                      "other": "agents-zoo"
                    }
                  }
                },
                {
                  "id": "agents-zoo",
                  "type": "block",
                  "content": {
                    "mod": "zoo",
                    "props": {
                      "side": true,
                      "stack": "agents",
                      "other": "agents-list"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "my-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "views",
              "type": "stack",
              "active": "chat",
              "children": [
                {
                  "id": "chat",
                  "title": "Chat",
                  "type": "block",
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "claude-chat",
                    "props": {
                      "stack": "views",
                      "self": "chat",
                      "other": "main"
                    }
                  }
                },
                {
                  "id": "main",
                  "title": "Terminal",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "my-pane",
                          "props": {
                            "stack": "views",
                            "other": "chat"
                          }
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "my-status"
          }
        }
      ]
    }
  ],
  "preview": "layouts/zoo.svg"
}
